{
  "syncs": [
    {
      "syncName": "syncDownContacts",
      "syncType": "syncDown",
      "soupName": "contacts",
      "target": {"type":"briefcase",
          "infos": [
            {
              "sobjectType": "Contact",
              "fieldlist": ["FirstName", "LastName", "Title", "MobilePhone", "Email", "Department", "HomePhone", "AccountId"],
              "soupName": "contacts"
            },
            {
              "sobjectType": "Account",
              "fieldlist": ["Name", "Phone", "Website", "Industry"],
              "soupName": "accounts"
            },
            {
              "sobjectType": "Opportunity",
              "fieldlist": ["Name", "Description", "CloseDate", "Amount", "AccountId"],
              "soupName": "opportunities"
            }
          ]
      },
      "options": {"mergeMode":"OVERWRITE"}
    },
    {
      "syncName": "syncUpContacts",
      "syncType": "syncUp",
      "soupName": "contacts",
      "target": {"createFieldlist":["FirstName", "LastName", "Title", "MobilePhone", "Email", "Department", "HomePhone"]},
      "options": {"fieldlist":["Id", "FirstName", "LastName", "Title", "MobilePhone", "Email", "Department", "HomePhone"], "mergeMode":"LEAVE_IF_CHANGED"}
    }
  ]
}
